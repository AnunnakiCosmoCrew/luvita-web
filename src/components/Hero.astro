---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
}

const { eyebrow, title, lead } = Astro.props;
---

<section class="hero">
  <div class="container hero-inner">
    {eyebrow && <p class="eyebrow reveal">{eyebrow}</p>}
    <h1 class="hero-title reveal reveal-2">{title}</h1>
    {lead && <p class="lead hero-lead reveal reveal-3">{lead}</p>}
    {
      Astro.slots.has('actions') && (
        <div class="hero-actions reveal reveal-3">
          <slot name="actions" />
        </div>
      )
    }
  </div>
</section>

<style>
  .hero {
    padding-block: var(--sp-5) var(--sp-6);
  }

  .hero-title {
    font-size: var(--fs-hero);
    max-width: 18ch;
    margin-top: var(--sp-4);
  }

  .hero-lead {
    margin-top: var(--sp-5);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    margin-top: var(--sp-6);
  }
</style>
