---
import { Image } from 'astro:assets';
import type { Product } from '../data/products';
import { t, type Locale } from '../i18n';

interface Props {
  product: Product;
  locale: Locale;
}

const { product, locale } = Astro.props;
const copy = product.copy[locale];
const dict = t(locale);
const statusLabel =
  product.status === 'live' ? dict.products.live : dict.products.inDevelopment;
---

<article class="product-card">
  <div class="product-head">
    {
      product.icon ? (
        <Image
          src={product.icon}
          alt=""
          width="56"
          height="56"
          densities={[1, 2]}
          class="product-icon"
        />
      ) : (
        <span class="product-icon product-monogram" aria-hidden="true">
          {product.name.charAt(0)}
        </span>
      )
    }
    <div>
      <h3>
        {
          product.url ? (
            <a
              class="product-link"
              href={product.url}
              rel="noopener noreferrer"
              target="_blank"
            >
              {product.name}
            </a>
          ) : (
            product.name
          )
        }
      </h3>
      <p class="product-tagline">{copy.tagline}</p>
    </div>
  </div>
  <p class="product-desc">{copy.description}</p>
  <p class="product-status" data-status={product.status}>
    <span class="status-dot" aria-hidden="true"></span>{statusLabel}
  </p>
</article>

<style>
  .product-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    padding: var(--sp-5);
    background-color: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
    transition: border-color var(--dur) var(--ease);
  }

  .product-card:hover {
    border-color: var(--c-accent);
  }

  .product-head {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
  }

  .product-icon {
    width: 56px;
    height: 56px;
    border-radius: var(--radius-sm);
    flex: none;
  }

  /* Fallback mark for products without an icon yet — no invented logos. */
  .product-monogram {
    display: grid;
    place-items: center;
    font-size: var(--fs-700);
    font-weight: 650;
    color: var(--c-accent);
    background-color: color-mix(in srgb, var(--c-accent) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--c-accent) 30%, transparent);
  }

  h3 {
    font-size: var(--fs-500);
  }

  /* Stretched link: the whole card is clickable when the product has a URL. */
  .product-link {
    color: var(--c-ink);
  }

  .product-link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .product-tagline {
    font-size: var(--fs-300);
    color: var(--c-muted);
  }

  .product-desc {
    color: var(--c-ink-soft);
  }

  .product-status {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    margin-top: auto;
    font-size: var(--fs-300);
    color: var(--c-muted);
  }

  .status-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    flex: none;
    background-color: var(--c-muted);
  }

  .product-status[data-status='live'] .status-dot {
    background-color: var(--c-ok);
  }
</style>
