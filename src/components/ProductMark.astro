---
/**
 * One mark per product (DESIGN.md section 5), inline SVG:
 *   umay       the brand icon "Two voices" (founder, 2026-11-17): two opening
 *              quotation marks as eyes over a half-disc smile, filled in ink
 *              and moss. Shapes are luvita-docs/brand/umay-icon.svg, unchanged.
 *              The moss eye is the right-hand one.
 *   cosmocrew  the brand mark "Glide" (founder, 2026-11-17, LW-84): a raven in
 *              flight, flying right, in CosmoCrew's own ink and lamp colours
 *              (not Luvita's). Shapes are luvita-docs/brand/cosmocrew-mark.svg,
 *              unchanged; the viewBox adds the brand's clear space (one eighth
 *              of the width on every side).
 *   pelerin    (Nesili) a line of text with two parts covered, a drawing in one
 *              line weight, `currentColor`, shown in the accent colour.
 * Read luvita-docs/brand/README.md before touching a brand mark, and never
 * swap, mirror, rotate or recolour one here. Both brand marks are used at
 * 32 px and up; at 24 px and below the brands' small drawings would be needed.
 * The marks identify a product; they never replace a real screen, except as
 * the documented fallback while a product has no screen yet.
 */
interface Props {
  product: string;
  size?: number;
  class?: string;
}

const { product, size = 40, class: className } = Astro.props;

// A product without a mark would leave an empty slot on the board; fail the
// build instead (a new or renamed key in products.ts needs a mark here).
if (!['umay', 'cosmocrew', 'pelerin'].includes(product)) {
  throw new Error(`ProductMark: no mark for product "${product}"`);
}
---

{
  product === 'umay' && (
    <svg
      class:list={['product-mark', 'product-mark-umay', className]}
      viewBox="0 0 32 32"
      width={size}
      height={size}
      aria-hidden="true"
      focusable="false"
    >
      <g transform="translate(5.4 0.2) scale(0.66)">
        <g transform="rotate(180 16 14)">
          <path
            class="accent"
            d="M2 9.5A6.5 6.5 0 0 1 15 9.5V16A9 9 0 0 1 6 25V20A4 4 0 0 0 8.5 16A6.5 6.5 0 0 1 2 9.5Z"
          />
          <path
            class="ink"
            d="M17 9.5A6.5 6.5 0 0 1 30 9.5V16A9 9 0 0 1 21 25V20A4 4 0 0 0 23.5 16A6.5 6.5 0 0 1 17 9.5Z"
          />
        </g>
      </g>
      <path class="ink" d="M7 21.5A9 9 0 0 0 25 21.5Z" />
    </svg>
  )
}
{
  product === 'cosmocrew' && (
    <svg
      class:list={['product-mark', 'product-mark-cosmocrew', className]}
      viewBox="-4 -4 40 40"
      width={size}
      height={size}
      aria-hidden="true"
      focusable="false"
    >
      <path
        class="bird"
        d="M31.5 13.5L27 10.5L24 10L21.5 11.5L12 5L2 2L5 5.5L1 6L4.5 9L1.5 10L13 15L8.5 18.5L3 19.5L0.5 23.5L5 26L10.5 22.5L17 20.5L24 27.5L30.5 30.5L26.5 22.5L23.5 17.5L25 15.5L24.5 14.5L27.5 14.5Z"
      />
      <circle class="eye" cx="24.6" cy="12.2" r="1" />
    </svg>
  )
}
{
  product === 'pelerin' && (
    <svg
      class:list={['product-mark', className]}
      viewBox="0 0 40 40"
      width={size}
      height={size}
      fill="none"
      stroke="currentColor"
      stroke-width="2.25"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
    >
      <path d="M3 20h4" />
      <rect x="10" y="15" width="9" height="10" rx="1.5" fill="currentColor" />
      <path d="M22 20h3" />
      <rect x="28" y="15" width="9" height="10" rx="1.5" fill="currentColor" />
    </svg>
  )
}

<style>
  .product-mark {
    flex: none;
    color: var(--c-accent);
  }

  /* The brand's ink and moss are the site's own tokens (tokens.css), so the
     icon follows the light and dark setting with the rest of the page. */
  .product-mark-umay .ink {
    fill: var(--c-ink);
  }

  .product-mark-umay .accent {
    fill: var(--c-accent);
  }

  /* CosmoCrew keeps its own colours (luvita-docs/brand/README.md, "Colour");
     they are brand values, not site tokens, so they live here. */
  .product-mark-cosmocrew .bird {
    fill: #131920;
  }

  .product-mark-cosmocrew .eye {
    fill: #75501a;
  }

  @media (prefers-color-scheme: dark) {
    .product-mark-cosmocrew .bird {
      fill: #e7e4dc;
    }

    .product-mark-cosmocrew .eye {
      fill: #e9c9a0;
    }
  }
</style>
