---
/**
 * One drawn mark per product (DESIGN.md section 5): inline SVG, one line
 * weight, `currentColor`, shown in the accent colour. Each is the simplest
 * true form of what the product does:
 *   umay       two voices taking turns
 *   pelerin    (Nesili) a line of text with two parts covered
 *   cosmocrew  a day as a circle cut into slices
 * The marks identify a product; they never replace a real screen, except as
 * the documented fallback while a product has no screen yet.
 */
interface Props {
  product: string;
  size?: number;
  class?: string;
}

const { product, size = 40, class: className } = Astro.props;
---

<svg
  class:list={['product-mark', className]}
  viewBox="0 0 40 40"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="2.25"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    product === 'umay' && (
      <>
        <path d="M6 6.5h17a3.5 3.5 0 0 1 3.5 3.5v5a3.5 3.5 0 0 1-3.5 3.5H12l-5 4v-4.2A3.5 3.5 0 0 1 2.5 15V10A3.5 3.5 0 0 1 6 6.5Z" />
        <path d="M34 19.5H17a3.5 3.5 0 0 0-3.5 3.5v5a3.5 3.5 0 0 0 3.5 3.5h11l5 4v-4.2a3.5 3.5 0 0 0 4.5-3.3V23a3.5 3.5 0 0 0-3.5-3.5Z" />
      </>
    )
  }
  {
    product === 'pelerin' && (
      <>
        <path d="M3 20h4" />
        <rect x="10" y="15" width="9" height="10" rx="1.5" fill="currentColor" />
        <path d="M22 20h3" />
        <rect x="28" y="15" width="9" height="10" rx="1.5" fill="currentColor" />
      </>
    )
  }
  {
    product === 'cosmocrew' && (
      <>
        <circle cx="20" cy="20" r="16.5" />
        <path d="M20 20V3.5" />
        <path d="M20 20l14.3 8.25" />
        <path d="M20 20l-11.7 11.7" />
        <path d="M20 20L4.1 15.7" />
      </>
    )
  }
</svg>

<style>
  .product-mark {
    flex: none;
    color: var(--c-accent);
  }
</style>
