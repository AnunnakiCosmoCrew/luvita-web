---
/**
 * One mark per product (DESIGN.md section 5), inline SVG:
 *   umay       the brand icon "Two voices" (founder, 2026-11-17): two opening
 *              quotation marks as eyes over a half-disc smile, filled in ink
 *              and moss. Shapes are luvita-docs/brand/umay-icon.svg, unchanged;
 *              read luvita-docs/brand/README.md before touching them, and never
 *              swap, mirror, rotate or recolour them here. The moss eye is the
 *              right-hand one. Used at 32 px and up; at 24 px and below the
 *              brand's small drawing (umay-favicon.svg) would be needed instead.
 *   pelerin    (Nesili) a line of text with two parts covered
 *   cosmocrew  a day as a circle cut into slices
 * The Nesili and CosmoCrew marks are drawings in one line weight, using
 * `currentColor`, shown in the accent colour. The marks identify a product;
 * they never replace a real screen, except as the documented fallback while a
 * product has no screen yet.
 */
interface Props {
  product: string;
  size?: number;
  class?: string;
}

const { product, size = 40, class: className } = Astro.props;
---

{
  product === 'umay' ? (
    <svg
      class:list={['product-mark', 'product-mark-umay', className]}
      viewBox="0 0 32 32"
      width={size}
      height={size}
      aria-hidden="true"
      focusable="false"
    >
      <g transform="translate(5.4 0.2) scale(0.66)">
        <g transform="rotate(180 16 14)">
          <path
            class="accent"
            d="M2 9.5A6.5 6.5 0 0 1 15 9.5V16A9 9 0 0 1 6 25V20A4 4 0 0 0 8.5 16A6.5 6.5 0 0 1 2 9.5Z"
          />
          <path
            class="ink"
            d="M17 9.5A6.5 6.5 0 0 1 30 9.5V16A9 9 0 0 1 21 25V20A4 4 0 0 0 23.5 16A6.5 6.5 0 0 1 17 9.5Z"
          />
        </g>
      </g>
      <path class="ink" d="M7 21.5A9 9 0 0 0 25 21.5Z" />
    </svg>
  ) : (
    <svg
      class:list={['product-mark', className]}
      viewBox="0 0 40 40"
      width={size}
      height={size}
      fill="none"
      stroke="currentColor"
      stroke-width="2.25"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
    >
      {
        product === 'pelerin' && (
          <>
            <path d="M3 20h4" />
            <rect x="10" y="15" width="9" height="10" rx="1.5" fill="currentColor" />
            <path d="M22 20h3" />
            <rect x="28" y="15" width="9" height="10" rx="1.5" fill="currentColor" />
          </>
        )
      }
      {
        product === 'cosmocrew' && (
          <>
            <circle cx="20" cy="20" r="16.5" />
            <path d="M20 20V3.5" />
            <path d="M20 20l14.3 8.25" />
            <path d="M20 20l-11.7 11.7" />
            <path d="M20 20L4.1 15.7" />
          </>
        )
      }
    </svg>
  )
}

<style>
  .product-mark {
    flex: none;
    color: var(--c-accent);
  }

  /* The brand's ink and moss are the site's own tokens (tokens.css), so the
     icon follows the light and dark setting with the rest of the page. */
  .product-mark-umay .ink {
    fill: var(--c-ink);
  }

  .product-mark-umay .accent {
    fill: var(--c-accent);
  }
</style>
