---
import { localizedPath, t, type Locale } from '../i18n';
import type { PagePaths } from '../layouts/BaseLayout.astro';

interface Props {
  locale: Locale;
  paths: PagePaths;
}

const { locale, paths } = Astro.props;
const dict = t(locale);

const slugs: Record<Locale, Record<string, string>> = {
  tr: { services: 'hizmetler', products: 'urunler', about: 'hakkimizda', contact: 'iletisim' },
  en: { services: 'services', products: 'products', about: 'about', contact: 'contact' },
};

const navItems = (['products', 'services', 'about', 'contact'] as const).map(
  (key) => ({ label: dict.nav[key], path: slugs[locale][key] })
);

const otherLocale: Locale = locale === 'tr' ? 'en' : 'tr';
const switchHref = localizedPath(otherLocale, paths[otherLocale]);

const current = (Astro.url.pathname.replace(/\/+$/, '') || '/').toLowerCase();

function isActive(path: string): boolean {
  const target = (localizedPath(locale, path).replace(/\/+$/, '') || '/').toLowerCase();
  return current === target || current.startsWith(target + '/');
}
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={localizedPath(locale)} aria-label={dict.nav.home}>
      <svg
        class="brand-mark"
        viewBox="0 0 32 32"
        width="26"
        height="26"
        aria-hidden="true"
        focusable="false"
      >
        <rect x="4" y="4" width="24" height="24" rx="7" fill="currentColor"
        ></rect>
        <path
          d="M12.5 10.5v9.5h8"
          fill="none"
          stroke="var(--c-bg)"
          stroke-width="3"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
      <span class="brand-name">Luvita</span>
    </a>

    <nav class="site-nav" aria-label={dict.nav.primary}>
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a
                href={localizedPath(locale, item.path)}
                aria-current={isActive(item.path) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            class="locale-switch"
            href={switchHref}
            aria-label={dict.nav.switchLocaleLabel}
            hreflang={otherLocale}
          >
            {dict.nav.switchLocale}
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: color-mix(in srgb, var(--c-bg) 88%, transparent);
    backdrop-filter: saturate(140%) blur(8px);
    border-bottom: 1px solid var(--c-border);
  }

  .header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3) var(--sp-5);
    padding-block: var(--sp-4);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-3);
    color: var(--c-ink);
    font-weight: 650;
    letter-spacing: 0.01em;
  }

  .brand:hover {
    color: var(--c-ink);
  }

  .brand-mark {
    color: var(--c-accent);
    flex: none;
  }

  .brand-name {
    font-size: var(--fs-500);
  }

  .site-nav ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-2) var(--sp-5);
    list-style: none;
    padding: 0;
  }

  .site-nav a {
    color: var(--c-ink-soft);
    font-size: var(--fs-400);
    font-weight: 550;
    padding-block: var(--sp-1);
  }

  .site-nav a:hover {
    color: var(--c-ink);
  }

  .site-nav a[aria-current='page'] {
    color: var(--c-ink);
    box-shadow: inset 0 -2px 0 0 var(--c-accent);
  }

  .locale-switch {
    padding-inline: var(--sp-3);
    border: 1px solid var(--c-border);
    border-radius: 999px;
    font-size: var(--fs-300);
  }

  .locale-switch:hover {
    border-color: var(--c-accent);
  }

  @media (max-width: 36rem) {
    .header-inner {
      justify-content: center;
    }
    .site-nav ul {
      justify-content: center;
    }
  }
</style>
