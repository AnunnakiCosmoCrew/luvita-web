---
import { localizedPath, t, type Locale } from '../i18n';
import type { PagePaths } from '../layouts/BaseLayout.astro';
import Wordmark from './Wordmark.astro';

interface Props {
  locale: Locale;
  paths: PagePaths;
}

const { locale, paths } = Astro.props;
const dict = t(locale);

const slugs: Record<Locale, Record<string, string>> = {
  tr: { products: 'urunler', about: 'hakkimizda', contact: 'iletisim' },
  en: { products: 'products', about: 'about', contact: 'contact' },
};

const navItems = (['products', 'about', 'contact'] as const).map(
  (key) => ({ label: dict.nav[key], path: slugs[locale][key] })
);

const otherLocale: Locale = locale === 'tr' ? 'en' : 'tr';
const switchHref = localizedPath(otherLocale, paths[otherLocale]);

const current = (Astro.url.pathname.replace(/\/+$/, '') || '/').toLowerCase();

function isActive(path: string): boolean {
  const target = (localizedPath(locale, path).replace(/\/+$/, '') || '/').toLowerCase();
  return current === target || current.startsWith(target + '/');
}
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={localizedPath(locale)} aria-label={dict.nav.home}>
      <Wordmark />
    </a>

    <nav class="site-nav" aria-label={dict.nav.primary}>
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a
                href={localizedPath(locale, item.path)}
                aria-current={isActive(item.path) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            class="locale-switch"
            href={switchHref}
            aria-label={dict.nav.switchLocaleLabel}
            hreflang={otherLocale}
          >
            {dict.nav.switchLocale}
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  /* DESIGN.md section 4: wordmark left; Products, Company, Contact and the
     language link right. Plain links, no button-styled link. */
  .site-header {
    border-bottom: var(--rule-thin) solid var(--c-rule);
  }

  .header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-2) var(--sp-5);
    padding-block: var(--sp-4);
  }

  .brand {
    display: inline-flex;
    align-items: baseline;
  }

  .site-nav ul {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--sp-2) var(--sp-5);
    list-style: none;
    padding: 0;
  }

  .site-nav a {
    color: var(--c-ink-soft);
    font-size: var(--fs-400);
    font-weight: 500;
    padding-block: var(--sp-1);
  }

  .site-nav a:hover {
    color: var(--c-ink);
    text-decoration: underline;
    text-decoration-color: var(--c-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
  }

  .site-nav a[aria-current='page'] {
    color: var(--c-ink);
    text-decoration: underline;
    text-decoration-color: var(--c-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
  }

  @media (max-width: 30rem) {
    .site-nav ul {
      gap: var(--sp-1) var(--sp-4);
    }
  }
</style>
