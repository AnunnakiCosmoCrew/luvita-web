---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import ProductCard from '../../components/ProductCard.astro';
import { products } from '../../data/products';
---

<BaseLayout
  locale="en"
  title="Products — Luvita"
  description="Luvita's products: the Umay AI agent platform, the Luvi Engine field quoting app and a yet-unannounced new product are in development; our shipped apps live under the CosmoCrew brand."
  paths={{ tr: 'urunler', en: 'products' }}
>
  <Hero
    eyebrow="Products"
    title="We design, ship and maintain"
    lead="We build our own products end to end — shipped apps under the CosmoCrew brand, three products in development."
  />

  <section class="container">
    <div class="product-grid">
      {products.map((product) => <ProductCard product={product} locale="en" />)}
    </div>
  </section>
</BaseLayout>
