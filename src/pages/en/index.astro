---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Button from '../../components/Button.astro';
import ProductCard from '../../components/ProductCard.astro';
import { localizedPath } from '../../i18n';
import { products } from '../../data/products';
---

<BaseLayout
  locale="en"
  title="Luvita — Software product company"
  description="Luvita is an independent software product company. We design, ship and maintain products of our own, with an engineering practice formed in banking and enterprise systems."
  paths={{ tr: '', en: '' }}
>
  <Hero
    eyebrow="An independent software laboratory"
    title="Software for the next decade."
    lead="The engineering practice we formed in banking and enterprise systems goes into products of our own — from design to release and years of upkeep."
  >
    <Fragment slot="actions">
      <Button href={localizedPath('en', 'products')}>See our products</Button>
      <Button href={localizedPath('en', 'contact')} variant="secondary">
        Get in touch
      </Button>
    </Fragment>
  </Hero>

  <section class="container">
    <div class="section-head">
      <p class="eyebrow">Products</p>
      <h2>Four products: one live, three in development</h2>
      <p class="lead">
        Our apps on the App Store are proof that we take software all the way
        from design to release and beyond. What we are building next shows
        where we are headed.
      </p>
    </div>
    <div class="product-grid">
      {products.map((product) => <ProductCard product={product} locale="en" />)}
    </div>
  </section>

  <section class="container">
    <div class="cta-panel">
      <h2>Let's talk about our products</h2>
      <p class="lead">
        Considering one of our products for your organisation, or curious
        where the roadmap goes next? Write to us — we answer every email.
      </p>
      <Button href={localizedPath('en', 'contact')}>Contact us</Button>
    </div>
  </section>
</BaseLayout>

<style>
  .cta-panel {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--sp-4);
    padding: var(--sp-6);
    background-color: var(--c-surface-2);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
  }
</style>
