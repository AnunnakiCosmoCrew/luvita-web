---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Button from '../../components/Button.astro';
import { CONTACT_EMAIL } from '../../lib/site';
---

<BaseLayout
  locale="en"
  title="Contact — Luvita"
  description="Get in touch with Luvita — send us an email and we will reply within a day."
  paths={{ tr: 'iletisim', en: 'contact' }}
>
  <Hero
    eyebrow="Contact"
    title="Get in touch"
    lead="A short email is enough — tell us what you have in mind in a few sentences and we'll get back to you within a day."
  >
    <Fragment slot="actions">
      <Button href={`mailto:${CONTACT_EMAIL}`}>Send an email</Button>
    </Fragment>
  </Hero>

  <section class="container">
    <div class="contact-grid">
      <div class="contact-card">
        <h2>Email</h2>
        <p><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></p>
        <p class="contact-note">We work remotely from Bodrum, Türkiye.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    gap: var(--sp-5);
    max-width: 24rem;
  }

  .contact-card {
    padding: var(--sp-5);
    background-color: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
  }

  .contact-card h2 {
    font-size: var(--fs-500);
    margin-bottom: var(--sp-2);
  }

  .contact-card p {
    color: var(--c-ink-soft);
  }

  .contact-note {
    margin-top: var(--sp-2);
    font-size: var(--fs-300);
    color: var(--c-muted);
  }
</style>
