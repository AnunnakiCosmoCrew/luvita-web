---
/**
 * Root entry page — the one URL that has to answer for itself.
 *
 * `https://luvita.tr/` used to be a 272-byte meta-refresh stub to `/tr/`;
 * anything that fetched the URL without running the refresh — a credit
 * programme's verifier, a bank, a crawler that stops at the root — saw a
 * blank page with no company name, no contact and no structured data. That
 * failure cost the Google for Startups round on umayconnect.org. See adr/0005.
 *
 * So the root SERVES the company's identity card as real HTML, in both
 * languages, and sits OUTSIDE the locale trees (adr/0002): it is its own
 * canonical and carries `hreflang="x-default"` — the URL that serves no
 * single language.
 *
 * On top of that content, JS-capable browsers are forwarded to their language
 * automatically (Turkish → /tr/, everything else → /en/) by the one inline
 * script below — the single sanctioned exception to the site's zero-JS rule
 * (adr/0006). It sets no cookies and makes no external request. No-JS clients
 * and crawlers never run it, so they still get the full identity card and the
 * JSON-LD: adr/0005's verification guarantee holds by construction.
 *
 * No street address appears here, and the visible copy no longer names the
 * city either — the registered office is the founder's home. The city
 * survives only in the machine-readable JSON-LD (OrganizationSchema), where a
 * verifier reads it; see `LOCATION` in src/lib/site.ts.
 */
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import { absoluteUrl } from '../lib/url';
import { localizedPath } from '../i18n';
import {
  BRAND,
  LEGAL_NAME,
  CONTACT_EMAIL,
  MERSIS_NO,
  TRADE_REGISTRY_NO,
} from '../lib/site';

const canonical = absoluteUrl();
const year = new Date().getFullYear();

// Locale targets for the progressive-enhancement redirect (adr/0006).
const trHref = localizedPath('tr');
const enHref = localizedPath('en');

/**
 * The head metadata stays brand-based. `LEGAL_NAME` contains "Enerji" and is
 * legal identity, not copy (adr/0003 as amended by adr/0005): it belongs in
 * the identity block below and in `legalName` in the JSON-LD, not in the
 * snippet a search result shows.
 */
const title = `${BRAND} Teknoloji — yazılım ürünleri şirketi · software product company`;
const description = `${BRAND}, Bodrum, Muğla merkezli bağımsız bir yazılım ürünleri şirketidir. ${BRAND} is an independent software product company based in Bodrum, Muğla, Türkiye. İletişim / contact: ${CONTACT_EMAIL}`;
---

<!doctype html>
<html lang="tr">
  <head>
    <BaseHead
      locale="tr"
      title={title}
      description={description}
      paths={{ tr: '', en: '' }}
      canonicalUrl={canonical}
    />
    <script is:inline define:vars={{ trHref, enHref }}>
      // Progressive enhancement (adr/0006): forward JS browsers to their
      // language — Turkish PRIMARY preference → /tr/, everything else → /en/.
      // Keying on the single most-preferred language (not "Turkish appears
      // anywhere") keeps an English-primary bilingual visitor on /en/. No-JS
      // clients and crawlers keep the identity card below. No cookies, no
      // external request. `replace` leaves no history entry (no back trap).
      try {
        var primary =
          (navigator.languages && navigator.languages[0]) ||
          navigator.language ||
          '';
        var prefersTr = /^tr\b/i.test(primary);
        window.location.replace(prefersTr ? trHref : enHref);
      } catch (e) {}
    </script>
  </head>
  <body>
    <main id="main" class="container entry">
      <h1>{BRAND}</h1>
      <p class="legal-name">
        <span class="legal-label">Tescilli unvan / Registered name</span>
        {LEGAL_NAME}
      </p>

      <p class="lead" lang="tr">
        Luvita, kendi yazılım ürünlerini geliştiren bağımsız bir şirkettir.
        Ürünlerini tasarlar, yayınlar ve bakımını üstlenir; mühendislik
        pratiği bankacılık ve kurumsal sistemlerden gelir.
      </p>
      <p class="lead" lang="en">
        Luvita is an independent software product company. We design, ship and
        maintain products of our own, with an engineering practice formed in
        banking and enterprise systems.
      </p>

      <nav class="locale-choice" aria-label="Dil / Language">
        <a class="locale-card" href={localizedPath('tr')} hreflang="tr" lang="tr">
          <span class="locale-name">Türkçe</span>
          <span class="locale-sub">Şirket, ürünler ve iletişim</span>
        </a>
        <a class="locale-card" href={localizedPath('en')} hreflang="en" lang="en">
          <span class="locale-name">English</span>
          <span class="locale-sub">Company, products and contact</span>
        </a>
      </nav>

      <address class="identity">
        <p class="identity-name">{LEGAL_NAME}</p>
        <p>
          <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
        </p>
        <p>
          {MERSIS_NO && <span>MERSİS No: {MERSIS_NO}</span>}
          {
            TRADE_REGISTRY_NO && (
              <span>
                {' '}· Ticaret Sicil No / Trade Registry No: {TRADE_REGISTRY_NO}
              </span>
            )
          }
        </p>
      </address>
    </main>

    <footer class="container entry-base">
      <p>
        &copy; {year} {BRAND}. Tüm hakları saklıdır. / All rights reserved.
      </p>
    </footer>
  </body>
</html>

<style>
  .entry {
    max-width: var(--maxw-prose);
    padding-block: var(--sp-8) var(--sp-7);
  }

  .entry h1 {
    margin-top: var(--sp-4);
    font-size: var(--fs-hero);
  }

  .legal-name {
    margin-top: var(--sp-3);
    font-size: var(--fs-400);
    color: var(--c-ink-soft);
    font-weight: 550;
  }

  .legal-label {
    display: block;
    font-size: var(--fs-300);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-muted);
  }

  .entry .lead {
    margin-top: var(--sp-5);
  }

  .entry .lead[lang='en'] {
    margin-top: var(--sp-4);
    color: var(--c-muted);
  }

  .locale-choice {
    display: grid;
    gap: var(--sp-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    margin-top: var(--sp-7);
  }

  .locale-card {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    padding: var(--sp-5);
    color: var(--c-ink);
    background-color: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
    transition:
      border-color var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }

  .locale-card:hover {
    color: var(--c-ink);
    border-color: var(--c-accent);
    transform: translateY(-2px);
  }

  .locale-name {
    font-weight: 650;
    color: var(--c-accent);
  }

  .locale-sub {
    font-size: var(--fs-300);
    color: var(--c-muted);
  }

  .identity {
    margin-top: var(--sp-7);
    padding-top: var(--sp-5);
    border-top: 1px solid var(--c-border);
    font-style: normal;
    font-size: var(--fs-300);
    color: var(--c-muted);
  }

  .identity p {
    margin-bottom: var(--sp-1);
  }

  .identity-name {
    font-weight: 550;
    color: var(--c-ink-soft);
  }

  .identity a {
    color: var(--c-muted);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .identity a:hover {
    color: var(--c-ink);
  }

  .entry-base {
    max-width: var(--maxw-prose);
    padding-bottom: var(--sp-7);
    font-size: var(--fs-300);
    color: var(--c-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .locale-card:hover {
      transform: none;
    }
  }
</style>
