---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Button from '../../components/Button.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import ProductCard from '../../components/ProductCard.astro';
import { localizedPath } from '../../i18n';
import { services } from '../../data/services';
import { products } from '../../data/products';
---

<BaseLayout
  locale="tr"
  title="Luvita — Yazılım stüdyosu"
  description="Luvita, bir yazılım stüdyosudur. Kendi ürünlerini geliştirir; seçili projelerde yazılımı uçtan uca üstlenir."
  paths={{ tr: '', en: '' }}
>
  <Hero
    title="Luvita, bir yazılım stüdyosudur."
    lead="Kendi ürünlerimizi geliştiriyoruz; seçili projelerde yazılımı uçtan uca üstleniyoruz."
  >
    <Fragment slot="actions">
      <Button href={localizedPath('tr', 'urunler')}>Ürünlerimizi görün</Button>
      <Button href={localizedPath('tr', 'iletisim')} variant="secondary">
        Projenizi konuşalım
      </Button>
    </Fragment>
  </Hero>

  <section class="container">
    <div class="section-head">
      <p class="eyebrow">Ürünler</p>
      <h2>İki ürün yayında, iki ürün geliştirmede</h2>
      <p class="lead">
        App Store’da yayında olan ürünlerimiz, tasarımdan yayına uçtan uca
        yazılım teslim edebildiğimizin kanıtı; geliştirmekte olduklarımız ise
        nereye baktığımızı gösteriyor.
      </p>
    </div>
    <div class="product-grid">
      {products.map((product) => <ProductCard product={product} locale="tr" />)}
    </div>
  </section>

  <section class="container">
    <div class="section-head">
      <p class="eyebrow">Hizmetler</p>
      <h2>Aynı pratik, sizin projeniz için</h2>
      <p class="lead">
        Ürünlerimizin arkasındaki mühendislik pratiğini seçili projelere
        taşıyoruz: keşiften geliştirmeye, yayına ve uzun soluklu bakıma.
      </p>
    </div>
    <div class="product-grid">
      {
        services.map((service) => (
          <ServiceCard service={service.copy.tr} />
        ))
      }
    </div>
  </section>

  <section class="container">
    <div class="cta-panel">
      <h2>Bir projeniz mi var?</h2>
      <p class="lead">
        İhtiyacınızı birlikte netleştirelim; kapsamı, yaklaşımı ve yol
        haritasını açıkça ortaya koyan bir teklifle dönelim.
      </p>
      <Button href={localizedPath('tr', 'iletisim')}>İletişime geçin</Button>
    </div>
  </section>
</BaseLayout>

<style>
  .cta-panel {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--sp-4);
    padding: var(--sp-6);
    background-color: var(--c-surface-2);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
  }
</style>
