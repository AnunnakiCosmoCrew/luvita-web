---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Button from '../../components/Button.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import { localizedPath } from '../../i18n';
import { services } from '../../data/services';
---

<BaseLayout
  locale="tr"
  title="Hizmetler — Luvita"
  description="Özel yazılım geliştirme, sistem entegrasyonu, teknik danışmanlık ve bakım-destek. Java/Spring Boot, Flutter ve bulut mimarileriyle üretim kalitesinde teslimat."
  paths={{ tr: 'hizmetler', en: 'services' }}
>
  <Hero
    eyebrow="Hizmetler"
    title="Uçtan uca yazılım hizmetleri"
    lead="Keşif ve tasarımdan geliştirme, entegrasyon ve uzun soluklu bakıma — yazılımın tüm yaşam döngüsünü tek elden üstleniyoruz."
  />

  <section class="container">
    <div class="product-grid">
      {
        services.map((service) => (
          <ServiceCard service={service.copy.tr} detailed />
        ))
      }
    </div>
  </section>

  <section class="container">
    <div class="section-head">
      <p class="eyebrow">Nasıl çalışıyoruz</p>
      <h2>Şeffaf kapsam, ölçülebilir teslimat</h2>
    </div>
    <ol class="process">
      <li>
        <h3>Keşif</h3>
        <p>
          İş sürecinizi ve mevcut sistemlerinizi anlıyor, kapsamı ve başarı
          ölçütlerini birlikte netleştiriyoruz.
        </p>
      </li>
      <li>
        <h3>Tasarım ve plan</h3>
        <p>
          Mimarî kararları gerekçeleriyle belgeliyor, yol haritasını ve
          kilometre taşlarını önceden paylaşıyoruz.
        </p>
      </li>
      <li>
        <h3>Geliştirme</h3>
        <p>
          Kısa döngülerle, otomatik testler ve sürekli entegrasyon (CI/CD)
          üzerinde geliştiriyoruz; ilerleme her an görünür.
        </p>
      </li>
      <li>
        <h3>Teslimat ve bakım</h3>
        <p>
          Yayına alma ile işimiz bitmiyor: izleme, güvenlik güncellemeleri ve
          anlaşmalı destekle yazılımınızı yaşatıyoruz.
        </p>
      </li>
    </ol>
  </section>

  <section class="container">
    <Button href={localizedPath('tr', 'iletisim')}>Projenizi konuşalım</Button>
  </section>
</BaseLayout>

<style>
  .process {
    display: grid;
    gap: var(--sp-5);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .process li {
    counter-increment: step;
    padding: var(--sp-5);
    background-color: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
  }

  .process h3 {
    font-size: var(--fs-500);
    margin-bottom: var(--sp-2);
  }

  .process h3::before {
    content: counter(step, decimal-leading-zero);
    display: block;
    font-family: var(--font-mono);
    font-size: var(--fs-300);
    color: var(--c-accent);
    margin-bottom: var(--sp-2);
  }

  .process p {
    color: var(--c-ink-soft);
  }
</style>
