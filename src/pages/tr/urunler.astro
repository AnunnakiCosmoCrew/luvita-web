---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import ProductCard from '../../components/ProductCard.astro';
import { products } from '../../data/products';
---

<BaseLayout
  locale="tr"
  title="Ürünler — Luvita"
  description="Luvita'nın ürünleri: Umay yapay zekâ ajanı platformu ve Luvi Engine saha teklif motoru geliştirme aşamasında; SliceFocus ve LexiPower App Store'da yayında."
  paths={{ tr: 'urunler', en: 'products' }}
>
  <Hero
    eyebrow="Ürünler"
    title="Tasarlıyor, yayınlıyor, yaşatıyoruz"
    lead="Kendi ürünlerimizi uçtan uca üretiyoruz: ikisi App Store'da yayında, ikisi geliştirme aşamasında. Müşterilerimize verdiğimiz sözün arkasında bu üretim pratiği var."
  />

  <section class="container">
    <div class="product-grid">
      {products.map((product) => <ProductCard product={product} locale="tr" />)}
    </div>
  </section>
</BaseLayout>
